<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/tech_bg_dark" android:padding="24dp">
    <TextView android:id="@+id/tvProfileTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Profile" android:textColor="@color/tech_white" android:textSize="26sp" android:textStyle="bold" />
    <TextView android:id="@+id/tvProfileGreeting" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:textColor="@color/tech_text_primary" android:textSize="18sp" />
    <TextView android:id="@+id/tvProfileEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/tech_text_secondary" android:textSize="14sp" />
    <com.google.android.material.button.MaterialButton android:id="@+id/btnProfileTrackRepairs" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="24dp" android:text="Track Repairs" android:textColor="@color/tech_white" app:backgroundTint="@color/tech_primary" />
    <com.google.android.material.button.MaterialButton android:id="@+id/btnProfileLogout" android:layout_height="52dp" android:layout_marginTop="24dp" android:text="Logout" android:textColor="@color/tech_white" app:backgroundTint="@color/tech_button_tint" />
</LinearLayout>
