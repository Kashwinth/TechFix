<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/tech_bg_dark">
    <LinearLayout android:id="@+id/layoutAdminHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_home_hero" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="18dp" android:paddingBottom="24dp" app:layout_constraintTop_toTopOf="parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:layout_width="42dp" android:layout_height="42dp" android:padding="9dp" android:src="@drawable/ic_profile" android:contentDescription="Admin profile" android:background="@drawable/bg_home_tile" app:tint="@color/tech_accent"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TechFix Manager" android:textSize="28sp" android:textStyle="bold" android:textColor="@color/tech_text_main"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Manage stock, services, and repair requests" android:textSize="13sp" android:textColor="@color/tech_text_sub"/>
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnAdminLogout" android:layout_width="wrap_content" android:layout_height="40dp" android:minHeight="0dp" android:text="Logout" android:textSize="12sp" android:textColor="@color/tech_text_main" android:iconTint="@color/tech_text_main" android:paddingHorizontal="10dp" style="@style/Widget.MaterialComponents.Button.OutlinedButton" app:strokeColor="@color/tech_accent" app:strokeWidth="1dp"/>
        </LinearLayout>
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="16dp" android:fillViewport="true" app:layout_constraintTop_toBottomOf="@id/layoutAdminHeader" app:layout_constraintBottom_toBottomOf="parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <com.google.android.material.card.MaterialCardView android:id="@+id/cardStock" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" app:cardBackgroundColor="@color/tech_surface" app:cardCornerRadius="8dp" app:strokeColor="#665FD4E3" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                    <LinearLayout android:id="@+id/headerStock" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:clickable="true" android:focusable="true">
                        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_inventory" android:contentDescription="Inventory" app:tint="@color/tech_accent"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:text="Manage Branch Stock" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/tech_white"/>
                        <ImageView android:id="@+id/iconStockToggle" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_chevron_down" android:contentDescription="Toggle stock section" app:tint="@color/tech_accent"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/contentStock" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="18dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Select branch" android:textSize="12sp" android:textColor="@color/tech_text_secondary"/>
                        <Spinner android:id="@+id/spinnerBranches" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_spinner_field" android:paddingStart="12dp" android:paddingEnd="8dp" android:layout_marginTop="6dp" android:layout_marginBottom="14dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Select spare part" android:textSize="12sp" android:textColor="@color/tech_text_secondary"/>
                        <Spinner android:id="@+id/spinnerParts" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_spinner_field" android:paddingStart="12dp" android:paddingEnd="8dp" android:layout_marginTop="6dp" android:layout_marginBottom="16dp"/>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="16dp">
                            <LinearLayout android:id="@+id/stockStat" android:layout_width="0dp" android:layout_height="64dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical" android:paddingHorizontal="14dp" android:background="@drawable/bg_stock_chip">
                                <TextView android:id="@+id/tvCurrentStock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/tech_accent"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="units in stock" android:textSize="11sp" android:textColor="@color/tech_text_secondary"/>
                            </LinearLayout>
                            <EditText android:id="@+id/etNewStock" android:layout_width="120dp" android:layout_height="50dp" android:layout_marginStart="12dp" android:hint="New qty" android:textColorHint="@color/tech_text_secondary" android:textColor="@color/tech_white" android:background="@drawable/bg_tech_field" android:paddingHorizontal="12dp" android:inputType="number"/>
                        </LinearLayout>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnUpdateStock" android:layout_width="match_parent" android:layout_height="52dp" android:text="Update Stock Count" android:textColor="@color/tech_white" app:backgroundTint="@color/tech_button_tint"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:id="@+id/cardService" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" app:cardBackgroundColor="@color/tech_surface" app:cardCornerRadius="8dp" app:strokeColor="#665FD4E3" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                    <LinearLayout android:id="@+id/headerService" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:clickable="true" android:focusable="true">
                        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_wrench" android:contentDescription="Repair service" app:tint="@color/tech_accent"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:text="Add Repair Service" android:textColor="@color/tech_white" android:textStyle="bold" android:textSize="17sp"/>
                        <ImageView android:id="@+id/iconServiceToggle" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_chevron_down" android:contentDescription="Toggle service section" app:tint="@color/tech_accent"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/contentService" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="18dp">
                        <EditText android:id="@+id/etAdminServiceCategory" android:layout_width="match_parent" android:layout_height="50dp" android:hint="Category (e.g. Mobile)" android:textColorHint="@color/tech_text_secondary" android:textColor="@color/tech_white" android:background="@drawable/bg_tech_field" android:paddingHorizontal="12dp" android:layout_marginBottom="12dp"/>
                        <EditText android:id="@+id/etAdminServiceName" android:layout_width="match_parent" android:layout_height="50dp" android:hint="Service name (e.g. Screen Replace)" android:textColorHint="@color/tech_text_secondary" android:textColor="@color/tech_white" android:background="@drawable/bg_tech_field" android:paddingHorizontal="12dp" android:layout_marginBottom="12dp"/>
                        <EditText android:id="@+id/etAdminServicePrice" android:layout_width="match_parent" android:layout_height="50dp" android:hint="Price (Rs.)" android:textColorHint="@color/tech_text_secondary" android:textColor="@color/tech_white" android:background="@drawable/bg_tech_field" android:paddingHorizontal="12dp" android:inputType="numberDecimal" android:layout_marginBottom="12dp"/>
                        <EditText android:id="@+id/etAdminServiceImage" android:layout_width="match_parent" android:layout_height="50dp" android:hint="Image URI (optional)" android:textColorHint="@color/tech_text_secondary" android:textColor="@color/tech_white" android:background="@drawable/bg_tech_field" android:paddingHorizontal="12dp" android:inputType="textUri" android:layout_marginBottom="16dp"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnSaveAdminService" android:layout_width="match_parent" android:layout_height="52dp" android:text="Save Service" android:textColor="@color/tech_white" app:backgroundTint="@color/tech_button_tint"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:id="@+id/cardStaffManagement" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" app:cardBackgroundColor="#1E1E1E" app:cardCornerRadius="12dp" app:strokeColor="#665FD4E3" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Staff Administration" android:textColor="@color/tech_white" android:textStyle="bold" android:textSize="16sp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnManageStaff" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:text="Manage Staff" android:textColor="@color/tech_white" app:backgroundTint="@color/tech_primary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:id="@+id/cardTechnicians" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" app:cardBackgroundColor="@color/tech_surface" app:cardCornerRadius="8dp" app:strokeColor="#665FD4E3" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                    <LinearLayout android:id="@+id/headerTechnicians" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:clickable="true" android:focusable="true">
                        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_profile" android:contentDescription="Technicians" app:tint="@color/tech_accent"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:text="Manage Technicians" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/tech_white"/>
                        <ImageView android:id="@+id/iconTechniciansToggle" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_chevron_down" android:contentDescription="Toggle technicians section" app:tint="@color/tech_accent"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/contentTechnicians" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="14dp">
                        <Spinner android:id="@+id/spinnerTechnicianBranch" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_spinner_field" android:layout_marginBottom="10dp"/>
                        <EditText android:id="@+id/etTechnicianName" android:layout_width="match_parent" android:layout_height="50dp" android:hint="Technician name" android:textColor="@color/tech_white" android:textColorHint="@color/tech_text_secondary" android:background="@drawable/bg_tech_field" android:paddingHorizontal="12dp"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnAddTechnician" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="10dp" android:text="Add Technician" android:textColor="@color/tech_white" app:backgroundTint="@color/tech_button_tint"/>
                        <LinearLayout android:id="@+id/technicianList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="10dp"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:id="@+id/cardSamples" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" app:cardBackgroundColor="@color/tech_surface" app:cardCornerRadius="8dp" app:strokeColor="#665FD4E3" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sample Repairs" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/tech_white"/>
                    <EditText android:id="@+id/etSampleCategory" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="12dp" android:hint="Device category" android:textColor="@color/tech_white" android:textColorHint="@color/tech_text_secondary" android:background="@drawable/bg_tech_field" android:paddingHorizontal="12dp"/>
                    <EditText android:id="@+id/etSampleDescription" android:layout_width="match_parent" android:layout_height="50dp" android:hint="Short description" android:textColor="@color/tech_white" android:textColorHint="@color/tech_text_secondary" android:background="@drawable/bg_tech_field" android:paddingHorizontal="12dp"/>
                    <TextView android:id="@+id/tvSampleImage" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="No image selected" android:textColor="@color/tech_text_secondary"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnChooseSampleImage" android:layout_width="match_parent" android:layout_height="50dp" android:text="Choose Image" android:textColor="@color/tech_white" app:backgroundTint="@color/tech_primary"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnSaveSample" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp" android:text="Save Sample Repair" android:textColor="@color/tech_white" app:backgroundTint="@color/tech_button_tint"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:id="@+id/cardGallery" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" app:cardBackgroundColor="@color/tech_surface" app:cardCornerRadius="8dp"><com.google.android.material.button.MaterialButton android:id="@+id/btnGallery" android:layout_width="match_parent" android:layout_height="52dp" android:text="Repair Gallery" android:textColor="@color/tech_white" app:backgroundTint="@color/tech_primary"/></com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:id="@+id/cardRequests" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="24dp" app:cardBackgroundColor="@color/tech_surface" app:cardCornerRadius="8dp" app:strokeColor="#665FD4E3" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                    <LinearLayout android:id="@+id/headerRequests" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:clickable="true" android:focusable="true">
                        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_clipboard" android:contentDescription="Repair requests" app:tint="@color/tech_accent"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:text="Customer Repair Requests" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/tech_white"/>
                        <ImageView android:id="@+id/iconRequestsToggle" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_chevron_down" android:contentDescription="Toggle requests section" app:tint="@color/tech_accent"/>
                    </LinearLayout>
                    <LinearLayout android:id="@+id/contentRequests" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="14dp">
                        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvAdminAppointments" android:layout_width="match_parent" android:layout_height="400dp" android:clipToPadding="false"/>
                        <TextView android:id="@+id/tvAdminEmptyMessage" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="24dp" android:text="No repair requests submitted yet." android:textColor="@color/tech_text_secondary" android:visibility="gone"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>