<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tech_bg_dark">

    <!-- Dashboard header -->
    <LinearLayout
        android:id="@+id/layoutAdminHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_home_hero"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="22dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_home_tile">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:contentDescription="Manager profile"
                    android:src="@drawable/ic_profile"
                    app:tint="@color/tech_accent" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="13dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MANAGEMENT PORTAL"
                    android:textColor="@color/tech_accent"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.14" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="TechFix Dashboard"
                    android:textColor="@color/tech_text_main"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdminLogout"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:minHeight="0dp"
                android:paddingHorizontal="12dp"
                android:text="Logout"
                android:textColor="@color/tech_text_main"
                android:textSize="11sp"
                app:icon="@drawable/ic_logout"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconSize="16dp"
                app:iconTint="@color/tech_accent"
                app:strokeColor="@color/tech_accent"
                app:strokeWidth="1dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Manage branch operations, inventory, teams and customer repairs from one place."
            android:textColor="@color/tech_text_sub"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="16dp"
        android:paddingTop="18dp"
        android:paddingEnd="16dp"
        android:paddingBottom="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutAdminHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:text="OPERATIONS"
                android:textColor="@color/tech_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <!-- Inventory -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/tech_surface"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/tech_outline_medium"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/headerStock"
                        android:layout_width="match_parent"
                        android:layout_height="68dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="18dp">

                        <FrameLayout
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_stock_chip">
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:contentDescription="Inventory"
                                android:src="@drawable/ic_inventory"
                                app:tint="@color/tech_accent" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Branch Inventory"
                                android:textColor="@color/tech_white"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Review and update spare-part stock"
                                android:textColor="@color/tech_text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/iconStockToggle"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="Toggle inventory section"
                            android:src="@drawable/ic_chevron_down"
                            app:tint="@color/tech_accent" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/tech_divider" />

                    <LinearLayout
                        android:id="@+id/contentStock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="18dp"
                        android:paddingTop="16dp"
                        android:paddingEnd="18dp"
                        android:paddingBottom="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="BRANCH"
                            android:textColor="@color/tech_text_secondary"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.08" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Select a branch first to manage its spare-part quantities"
                            android:textColor="@color/tech_text_secondary"
                            android:textSize="12sp" />
                        <Spinner
                            android:id="@+id/spinnerBranches"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_spinner_field"
                            android:paddingStart="12dp"
                            android:paddingEnd="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="SPARE PART"
                            android:textColor="@color/tech_text_secondary"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.08" />
                        <Spinner
                            android:id="@+id/spinnerParts"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_spinner_field"
                            android:paddingStart="12dp"
                            android:paddingEnd="8dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:id="@+id/stockStat"
                                android:layout_width="0dp"
                                android:layout_height="68dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_stock_chip"
                                android:gravity="center_vertical"
                                android:orientation="vertical"
                                android:paddingHorizontal="14dp">
                                <TextView
                                    android:id="@+id/tvCurrentStock"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="--"
                                    android:textColor="@color/tech_accent"
                                    android:textSize="24sp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="CURRENT UNITS"
                                    android:textColor="@color/tech_text_secondary"
                                    android:textSize="9sp"
                                    android:textStyle="bold"
                                    android:letterSpacing="0.08" />
                            </LinearLayout>

                            <EditText
                                android:id="@+id/etNewStock"
                                android:layout_width="128dp"
                                android:layout_height="56dp"
                                android:layout_marginStart="12dp"
                                android:background="@drawable/bg_tech_field"
                                android:hint="New quantity"
                                android:inputType="number"
                                android:paddingHorizontal="12dp"
                                android:textColor="@color/tech_white"
                                android:textColorHint="@color/tech_text_secondary"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnUpdateStock"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="14dp"
                            android:text="Update Stock"
                            android:textColor="@color/tech_white"
                            app:backgroundTint="@color/tech_button_tint"
                            app:icon="@drawable/ic_inventory"
                            app:iconGravity="textStart"
                            app:iconTint="@color/tech_white" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Services -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardService"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/tech_surface"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/tech_outline_medium"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/headerService"
                        android:layout_width="match_parent"
                        android:layout_height="68dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="18dp">

                        <FrameLayout
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_stock_chip">
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:contentDescription="Services"
                                android:src="@drawable/ic_wrench"
                                app:tint="@color/tech_accent" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Service Catalogue"
                                android:textColor="@color/tech_white"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Add a repair service and its price"
                                android:textColor="@color/tech_text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/iconServiceToggle"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="Toggle service section"
                            android:src="@drawable/ic_chevron_down"
                            app:tint="@color/tech_accent" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/tech_divider" />

                    <LinearLayout
                        android:id="@+id/contentService"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">
                        <EditText
                            android:id="@+id/etAdminServiceCategory"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_tech_field"
                            android:hint="Category, e.g. Mobile"
                            android:paddingHorizontal="12dp"
                            android:textColor="@color/tech_white"
                            android:textColorHint="@color/tech_text_secondary" />
                        <EditText
                            android:id="@+id/etAdminServiceName"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_tech_field"
                            android:hint="Service name"
                            android:paddingHorizontal="12dp"
                            android:textColor="@color/tech_white"
                            android:textColorHint="@color/tech_text_secondary" />
                        <EditText
                            android:id="@+id/etAdminServicePrice"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_tech_field"
                            android:hint="Price (LKR)"
                            android:inputType="numberDecimal"
                            android:paddingHorizontal="12dp"
                            android:textColor="@color/tech_white"
                            android:textColorHint="@color/tech_text_secondary" />
                        <EditText
                            android:id="@+id/etAdminServiceImage"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_tech_field"
                            android:hint="Image URI (optional)"
                            android:inputType="textUri"
                            android:paddingHorizontal="12dp"
                            android:textColor="@color/tech_white"
                            android:textColorHint="@color/tech_text_secondary" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSaveAdminService"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="14dp"
                            android:text="Add Service"
                            android:textColor="@color/tech_white"
                            app:backgroundTint="@color/tech_button_tint"
                            app:icon="@drawable/ic_wrench"
                            app:iconTint="@color/tech_white" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_marginTop="8dp"
                android:text="TEAM &amp; ACCESS"
                android:textColor="@color/tech_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <!-- Staff access -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStaffManagement"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/tech_privileged_surface"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/tech_accent"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="18dp">
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="Staff access"
                        android:src="@drawable/ic_profile"
                        app:tint="@color/tech_accent" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Staff Administration"
                            android:textColor="@color/tech_white"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Create staff and manager accounts"
                            android:textColor="@color/tech_text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnManageStaff"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="13dp"
                        android:text="Manage"
                        android:textColor="@color/tech_white"
                        android:textSize="11sp"
                        app:backgroundTint="@color/tech_primary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Technicians -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTechnicians"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/tech_surface"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/tech_outline_medium"
                app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <LinearLayout
                        android:id="@+id/headerTechnicians"
                        android:layout_width="match_parent"
                        android:layout_height="68dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="18dp">
                        <FrameLayout android:layout_width="38dp" android:layout_height="38dp" android:background="@drawable/bg_stock_chip">
                            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:contentDescription="Technicians" android:src="@drawable/ic_profile" app:tint="@color/tech_accent" />
                        </FrameLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Technician Availability" android:textColor="@color/tech_white" android:textSize="16sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Add technicians and control active status" android:textColor="@color/tech_text_secondary" android:textSize="11sp" />
                        </LinearLayout>
                        <ImageView android:id="@+id/iconTechniciansToggle" android:layout_width="22dp" android:layout_height="22dp" android:contentDescription="Toggle technicians section" android:src="@drawable/ic_chevron_down" app:tint="@color/tech_accent" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/tech_divider" />
                    <LinearLayout
                        android:id="@+id/contentTechnicians"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ASSIGNED BRANCH" android:textColor="@color/tech_text_secondary" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.08" />
                        <Spinner android:id="@+id/spinnerTechnicianBranch" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="6dp" android:background="@drawable/bg_spinner_field" />
                        <EditText android:id="@+id/etTechnicianName" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:background="@drawable/bg_tech_field" android:hint="Technician name" android:paddingHorizontal="12dp" android:textColor="@color/tech_white" android:textColorHint="@color/tech_text_secondary" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnAddTechnician" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="10dp" android:text="Add Technician" android:textColor="@color/tech_white" app:backgroundTint="@color/tech_button_tint" app:icon="@drawable/ic_profile" app:iconTint="@color/tech_white" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="TEAM STATUS" android:textColor="@color/tech_text_secondary" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.08" />
                        <LinearLayout android:id="@+id/technicianList" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="vertical" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_marginTop="8dp"
                android:text="CUSTOMER EXPERIENCE"
                android:textColor="@color/tech_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <!-- Gallery samples -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSamples"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/tech_surface"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/tech_outline_medium"
                app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="Gallery sample" android:src="@drawable/ic_computer" app:tint="@color/tech_accent" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Showcase a Repair" android:textColor="@color/tech_white" android:textSize="16sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Add completed work to the customer gallery" android:textColor="@color/tech_text_secondary" android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Add a completed repair example here. It will appear in the customer Repair Gallery on this device." android:textColor="@color/tech_text_secondary" android:textSize="12sp" />
                    <EditText android:id="@+id/etSampleCategory" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="16dp" android:background="@drawable/bg_tech_field" android:hint="Device category" android:paddingHorizontal="12dp" android:textColor="@color/tech_white" android:textColorHint="@color/tech_text_secondary" />
                    <EditText android:id="@+id/etSampleDescription" android:layout_width="match_parent" android:layout_height="70dp" android:layout_marginTop="10dp" android:background="@drawable/bg_tech_field" android:gravity="top|start" android:hint="Short repair description" android:padding="12dp" android:textColor="@color/tech_white" android:textColorHint="@color/tech_text_secondary" />
                    <TextView android:id="@+id/tvSampleImage" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_home_tile" android:padding="12dp" android:text="No image selected" android:textColor="@color/tech_text_secondary" android:textSize="12sp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical">
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnChooseSampleImage" android:layout_width="match_parent" android:layout_height="50dp" android:text="Choose Repair Image" android:textColor="@color/tech_white" android:textSize="12sp" app:backgroundTint="@color/tech_primary" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnSaveSample" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="8dp" android:text="Save to Customer Gallery" android:textColor="@color/tech_white" android:textSize="12sp" app:backgroundTint="@color/tech_button_tint" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGallery"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="12dp"
                android:text="Open Repair Gallery"
                android:textColor="@color/tech_accent"
                app:icon="@drawable/ic_computer"
                app:iconTint="@color/tech_accent"
                app:strokeColor="@color/tech_accent"
                app:strokeWidth="1dp" />

            <!-- Repair requests -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRequests"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/tech_surface"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/tech_outline_medium"
                app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <LinearLayout
                        android:id="@+id/headerRequests"
                        android:layout_width="match_parent"
                        android:layout_height="72dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="18dp">
                        <FrameLayout android:layout_width="38dp" android:layout_height="38dp" android:background="@drawable/bg_stock_chip">
                            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:contentDescription="Repair requests" android:src="@drawable/ic_clipboard" app:tint="@color/tech_accent" />
                        </FrameLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Customer Repair Queue" android:textColor="@color/tech_white" android:textSize="16sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Review requests and update repair progress" android:textColor="@color/tech_text_secondary" android:textSize="11sp" />
                        </LinearLayout>
                        <ImageView android:id="@+id/iconRequestsToggle" android:layout_width="22dp" android:layout_height="22dp" android:contentDescription="Toggle requests section" android:src="@drawable/ic_chevron_down" app:tint="@color/tech_accent" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/tech_divider" />
                    <LinearLayout
                        android:id="@+id/contentRequests"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="14dp"
                        android:paddingTop="14dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="16dp">
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvAdminAppointments"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clipToPadding="false"
                            android:nestedScrollingEnabled="false"
                            android:paddingBottom="4dp" />
                        <TextView
                            android:id="@+id/tvAdminEmptyMessage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:padding="30dp"
                            android:text="No repair requests yet.\nNew customer bookings will appear here."
                            android:textColor="@color/tech_text_secondary"
                            android:textSize="13sp"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
