<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:background="@color/tech_bg_dark" android:padding="16dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Repair history"
        android:textColor="@color/tech_text_primary" android:textStyle="bold" android:textSize="26sp" android:layout_marginBottom="12dp"/>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvRepairHistory" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingBottom="12dp"/>
    <TextView android:id="@+id/tvHistoryEmpty" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="No repair requests yet." android:textColor="@color/tech_text_secondary" android:gravity="center"
        android:padding="32dp" android:visibility="gone"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/btnHistoryBack" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Back to dashboard" app:backgroundTint="@color/tech_button_tint"/>
</LinearLayout>
