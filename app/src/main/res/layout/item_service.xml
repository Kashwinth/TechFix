<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" app:cardBackgroundColor="@color/tech_surface" app:cardCornerRadius="8dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="14dp">
  <ImageView android:id="@+id/ivServiceImage" android:layout_width="64dp" android:layout_height="64dp" android:src="@drawable/techfix_logo" android:scaleType="centerCrop" android:contentDescription="Repair service sample"/>
  <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
   <TextView android:id="@+id/tvServiceName" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/tech_text_primary" android:textStyle="bold" android:textSize="17sp"/>
   <TextView android:id="@+id/tvServiceCategory" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/tech_text_secondary" android:layout_marginTop="4dp"/>
   <TextView android:id="@+id/tvServicePrice" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/tech_accent" android:textStyle="bold" android:layout_marginTop="4dp"/>
  </LinearLayout>
 </LinearLayout>
</com.google.android.material.card.MaterialCardView>
