<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/tech_bg_dark">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="20dp">

    <!-- Header Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="24dp">

        <TextView
            android:id="@+id/tvWelcomeUser"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/welcome_customer"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/tech_white" />

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/logout"
            android:textSize="12sp"
            android:minHeight="40dp"
            android:backgroundTint="@color/tech_button_tint" />
    </LinearLayout>

    <!-- Quick Status Card (Tracks active repair progress) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/current_repair_status"
        android:textColor="@color/tech_text_secondary"
        android:textSize="14sp"
        android:layout_marginBottom="8dp"/>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        app:cardBackgroundColor="@color/tech_surface"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/tech_accent"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView
                android:id="@+id/tvActiveRepairTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/asus_tuf_gaming_a15_screen_replacement"
                android:textColor="@color/tech_white"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="4dp"/>
            <TextView
                android:id="@+id/tvActiveRepairStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_assigned_to_colombo_branch_in_progress"
                android:textColor="@color/tech_accent"
                android:textSize="14sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/tech_surface"
        app:cardCornerRadius="8dp"
        app:strokeColor="#665FD4E3"
        app:strokeWidth="1dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Our Locations"
                android:textColor="@color/tech_accent"
                android:textSize="20sp"
                android:textStyle="bold" />
            <com.example.techfix.views.OfflineBranchMapView
                android:id="@+id/customerBranchMap"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="14dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCustomerNearestBranch"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:text="Find Nearest Branch"
                android:textColor="@color/tech_white"
                app:backgroundTint="@color/tech_button_tint" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewTechnicians"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:text="View Technicians"
                android:textColor="@color/tech_white"
                app:backgroundTint="@color/tech_primary" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCustomerTrackRepairs"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="2dp"
        android:text="Track Repairs / Repair History"
        android:textColor="@color/tech_white"
        app:backgroundTint="@color/tech_button_tint"
        app:icon="@drawable/ic_track"
        app:iconTint="@color/tech_white" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCustomerGallery"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:text="Repair Gallery"
        android:textColor="@color/tech_white"
        app:backgroundTint="@color/tech_primary" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include layout="@layout/customer_bottom_nav" />

</LinearLayout>