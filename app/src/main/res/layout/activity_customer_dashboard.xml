<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/tech_bg_dark"
    android:padding="24dp">

    <!-- Header Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="24dp">

        <TextView
            android:id="@+id/tvWelcomeUser"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/welcome_customer"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/tech_white" />

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/logout"
            android:textSize="12sp"
            android:minHeight="40dp"
            android:backgroundTint="@color/tech_button_tint" />
    </LinearLayout>

    <!-- Quick Status Card (Tracks active repair progress) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/current_repair_status"
        android:textColor="@color/tech_text_secondary"
        android:textSize="14sp"
        android:layout_marginBottom="8dp"/>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        app:cardBackgroundColor="@color/tech_surface"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/tech_accent"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView
                android:id="@+id/tvActiveRepairTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/asus_tuf_gaming_a15_screen_replacement"
                android:textColor="@color/tech_white"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="4dp"/>
            <TextView
                android:id="@+id/tvActiveRepairStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_assigned_to_colombo_branch_in_progress"
                android:textColor="@color/tech_accent"
                android:textSize="14sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/tech_surface"
        app:cardCornerRadius="8dp"
        app:strokeColor="#665FD4E3"
        app:strokeWidth="1dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Our Locations"
                android:textColor="@color/tech_accent"
                android:textSize="20sp"
                android:textStyle="bold" />
            <com.example.techfix.views.OfflineBranchMapView
                android:id="@+id/customerBranchMap"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="14dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCustomerNearestBranch"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:text="Find Nearest Branch"
                android:textColor="@color/tech_white"
                app:backgroundTint="@color/tech_button_tint" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewTechnicians"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:text="View Technicians"
                android:textColor="@color/tech_white"
                app:backgroundTint="@color/tech_primary" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCustomerGallery"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="18dp"
        android:text="Repair Gallery"
        android:textColor="@color/tech_white"
        app:backgroundTint="@color/tech_primary" />

    <LinearLayout
        android:id="@+id/customerBottomNav"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@color/tech_surface"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">
        <LinearLayout android:id="@+id/customerNavHome" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true">
            <ImageView android:layout_width="23dp" android:layout_height="23dp" android:src="@drawable/ic_home" app:tint="@color/tech_accent" android:contentDescription="Home" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Home" android:textColor="@color/tech_accent" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:id="@+id/customerNavServices" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true">
            <ImageView android:layout_width="23dp" android:layout_height="23dp" android:src="@drawable/ic_wrench" app:tint="@color/tech_text_sub" android:contentDescription="Services" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Services" android:textColor="@color/tech_text_sub" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/customerNavBook" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true">
            <ImageView android:layout_width="23dp" android:layout_height="23dp" android:src="@drawable/ic_book" app:tint="@color/tech_text_sub" android:contentDescription="Book" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Book" android:textColor="@color/tech_text_sub" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/customerNavProfile" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true">
            <ImageView android:layout_width="23dp" android:layout_height="23dp" android:src="@drawable/ic_profile" app:tint="@color/tech_text_sub" android:contentDescription="Profile" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Profile" android:textColor="@color/tech_text_sub" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>